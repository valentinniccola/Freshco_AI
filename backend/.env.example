# ==========================================
# Freshco AI - Backend Environment Variables
# ==========================================

# Secret Key for JWT Tokens
SECRET_KEY=your-super-secret-jwt-key

# Database Connection URL (Optional - defaults to SQLite, or set to PostgreSQL for Vercel / Cloud)
# e.g. postgresql://user:password@db.supabase.co:5432/postgres
DATABASE_URL=

# Frontend URL for CORS configuration (e.g. https://your-frontend.vercel.app)
FRONTEND_URL=

# Gmail SMTP Configuration for 6-Digit Password Reset Codes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAILS_FROM_NAME="Freshco AI Security"

# Password Reset Configuration
RESET_CODE_EXPIRE_MINUTES=10
RESET_MAX_REQUESTS_PER_HOUR=3

# LLM API Key (Optional - Anthropic Claude for Agentic Multi-Item Recipes)
ANTHROPIC_API_KEY=
